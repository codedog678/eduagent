+    PolicyArtifactRecord, PolicyAuditEventRecord, PolicyDeploymentRecord,
+    PolicyEnvironmentHeadRecord, PolicyGateReceiptRecord, PolicyHealthWindowRecord,
+    PolicyObservationRecord,
+)

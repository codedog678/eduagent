+    assert bool(health) == (breakage == "valid")
+    if health:
+        assert all(r["health_source"]["relation"] == "consumed_chain" for r in health)
+    assert "append-only exact relationship" not in str(body)
+
+
+@pytest.mark.parametrize("field,value", [

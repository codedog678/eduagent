# ===========================================
# 英语学习智能教育系统 - 环境变量配置
# ===========================================
# 复制此文件为 .env 并填入你的真实值
# cp .env.example .env
# 注意：.env 文件已在 .gitignore 中，不会被上传到 GitHub

# LLM API 配置（选择一个即可）
# 优先使用 Anthropic（推荐）
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
MODEL_ID=claude-3-sonnet-20240229

# 或使用 OpenAI
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o

# 或使用 MiniMax
# MINIMAX_API_KEY=your-minimax-api-key-here
# MINIMAX_MODEL=MiniMax-M2.7

# 或使用 DeepSeek
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_MODEL=deepseek-chat

# 数据库配置（PostgreSQL）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/edu_agent

# Redis 配置（可选，当前未使用）
# REDIS_URL=redis://localhost:6379/0

# 服务端口
PYTHON_API_PORT=8888
FRONTEND_PORT=3000

# 日志级别
LOG_LEVEL=INFO

# 数据库日志（事件溯源）
ENABLE_DB_LOGGING=true

# Harness：单个后端 worker，共享执行队列和原子检查点
HARNESS_STORE_PATH=data/harness.sqlite3
HARNESS_TIMEOUT_SECONDS=45
HARNESS_MAX_STEPS=64
QUIZ_TTL_SECONDS=86400
ENABLE_AGENT_LLM_DECISIONS=false
LLM_TIMEOUT_SECONDS=12

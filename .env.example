# ===========================================
# 英语学习智能教育系统 - 环境变量配置
# ===========================================
# 复制此文件为 .env 并填入你的真实值
# cp .env.example .env
# 注意：.env 文件已在 .gitignore 中，不会被上传到 GitHub

# LLM API 配置：显式选择可避免已有 Key 抢占
# auto 按 Anthropic > OpenAI > MiniMax > DeepSeek 自动选择；无 Key 使用模板
LLM_PROVIDER=auto

# 使用 DeepSeek Flash（支持原生工具调用）
# 官方模型与价格：https://api-docs.deepseek.com/zh-cn/quick_start/pricing/
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
# 默认关闭思考建立评测基线；改为 enabled 可开启思考对照
# DEEPSEEK_THINKING=disabled
# 开启思考时生效，可选 high / max
# DEEPSEEK_REASONING_EFFORT=high

# 或使用 Anthropic
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# MODEL_ID=claude-3-sonnet-20240229

# 或使用 OpenAI
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o

# 或使用 MiniMax
# MINIMAX_API_KEY=your-minimax-api-key-here
# MINIMAX_MODEL=MiniMax-M2.7

# 数据库配置（PostgreSQL）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/edu_agent

# Redis 配置（可选，当前未使用）
# REDIS_URL=redis://localhost:6379/0

# 服务端口
PYTHON_API_PORT=8888
FRONTEND_PORT=3000

# 日志级别
LOG_LEVEL=INFO

# 数据库日志（事件溯源）
ENABLE_DB_LOGGING=true

# Harness：单个后端 worker，共享执行队列和原子检查点
HARNESS_STORE_PATH=data/harness.sqlite3
HARNESS_TIMEOUT_SECONDS=45
HARNESS_MAX_STEPS=64
QUIZ_TTL_SECONDS=86400
ENABLE_AGENT_LLM_DECISIONS=false
LLM_TIMEOUT_SECONDS=12

# Tutor 原生工具循环；无远程模型时保留明确标记的文本/模板路径
ENABLE_TUTOR_TOOLS=true
TUTOR_MAX_MODEL_CALLS=3
TUTOR_MAX_TOOL_CALLS=4
TUTOR_CONTEXT_BUDGET_TOKENS=6000
TUTOR_MAX_OUTPUT_TOKENS=800
TUTOR_HANDLER_TIMEOUT_SECONDS=40
